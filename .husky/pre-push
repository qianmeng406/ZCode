#!/usr/bin/env sh

# 推送前先跑 lint 再跑单测，先用更快的静态检查尽早拦住低成本问题，
# 避免还没过代码质量门槛就进入更慢的测试阶段。
# Git 会通过 stdin 传入本次 push 的 local/remote ref 与 sha；先缓存下来，后续
# affected-test 脚本才能用远端当前 sha 作为 base，而不是误退回到默认分支。
# 手工执行 hook 时 stdin 可能是终端，避免直接 cat 卡住调试。
pre_push_stdin=""
if [ ! -t 0 ]; then
  pre_push_stdin=$(cat)
fi
# Bugfix: Git hook 会注入 GIT_DIR/GIT_WORK_TREE 等 local env。
# 不清理会让单测里的临时仓库 Git 命令误命中当前仓库（例如把功能分支改名为 main）。
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)
# 修复原因：强制 mise 会阻止已用其他方式准备好 Node/pnpm 的开发者推送；沿用当前环境。
# 门禁由 scripts/pre-push-gate.mjs 包装：
# - 门禁本体是 scripts/git-gate/run-pre-push.mjs（文件策略 → 改动文件 lint/fmt →
#   架构检查 → 强相关测试），不会跑全量单测；
# - 「同一推送范围 + 同一工具链环境 + 同一 scope」已完整通过时跳过重复门禁
#   （只缓存通过结果，失败绝不缓存；工作区有未提交改动、无法确定推送范围或
#   ZCODE_PREPUSH_NO_CACHE=1 时一律照跑）。
node_bin=$(command -v node 2>/dev/null || command -v node.exe 2>/dev/null || true)
if [ -z "$node_bin" ]; then
  echo "git-gate: 未找到 node / node.exe，请先准备 Node.js。" >&2
  exit 127
fi
ZCODE_PRE_PUSH_STDIN="$pre_push_stdin" "$node_bin" scripts/pre-push-gate.mjs
